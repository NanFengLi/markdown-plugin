{
  "manifest_version": 3,
  "name": "本地 Markdown 阅读器",
  "version": "1.2.0",
  "description": "在 Chrome 和 Edge 中私密地阅读本地 Markdown 文件夹，支持目录树、大纲与排序。",
  "permissions": ["storage"],
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "action": {
    "default_title": "打开本地 Markdown 阅读器",
    "default_icon": {
      "16": "assets/icon16.png",
      "32": "assets/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "reader.html",
  "commands": {
    "open-reader": {
      "suggested_key": {
        "default": "Ctrl+Shift+M",
        "mac": "Command+Shift+M"
      },
      "description": "打开本地 Markdown 阅读器"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  }
}
